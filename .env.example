# Copy to .env. Never commit .env.

NODE_ENV=development
PORT=3000
CLIENT_URL=http://127.0.0.1:5173

# Required for a live deployment. Local development falls back to mongodb://127.0.0.1:27017/fluxo
MONGO_URI=

# Required for a live deployment. Development uses a local-only fallback.
JWT_SECRET=
COOKIE_SECRET=

# Stripe. Leave unset locally to use the simulated checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Emails are skipped when unset.
RESEND_API_KEY=

# Optional. Product uploads are stored locally when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional admin seed. Development seeds admin@fluxo.test when this is unset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to 0 to skip seeding.
SEED=
