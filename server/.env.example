# Backend env (also loaded from repo root `.env` in production)
# Copy to server/.env for local API-only dev (`npm run dev` in server/)

PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/flexo
JWT_SECRET=replace-with-long-random-secret
COOKIE_SECRET=replace-with-long-random-secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_USER=
EMAIL_PASS=

# Must match the frontend origin (Next dev: http://localhost:3000)
CLIENT_URL=http://localhost:3000

ARCJET_KEY=
